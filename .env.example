# ============================================================
# Football Betting Advisor 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---- DuckDB -----
# DuckDB 数据库文件路径（默认项目根目录下的 football_system.db）
FOOTBALL_DUCKDB_PATH=football_system.db

# ---- ChromaDB ----
# ChromaDB 持久化目录
FOOTBALL_CHROMA_PERSIST_DIRECTORY=chroma_store
# ChromaDB collection 名称
FOOTBALL_CHROMA_COLLECTION=football_news
# ChromaDB 检索距离阈值 (0-2, 默认 0.7)
FOOTBALL_CHROMA_MAX_DISTANCE=0.7
# Embedding 模型名 (Ollama 中的模型名)
FOOTBALL_CHROMA_EMBEDDING_MODEL=bge-m3
FOOTBALL_CHROMA_EMBEDDING_MODEL_VERSION=bge-m3
# Ollama Embedding API 地址
FOOTBALL_CHROMA_OLLAMA_BASE_URL=http://localhost:11434/api/embeddings

# ---- LLM 路由 ----
# 外部 OpenAI-compatible LLM (可选，不配置则只用本地 Qwen)
# FOOTBALL_EXTERNAL_LLM_BASE_URL=<YOUR_LLM_BASE_URL>
# FOOTBALL_EXTERNAL_LLM_API_KEY=<YOUR_API_KEY>
FOOTBALL_EXTERNAL_LLM_MODEL=gpt-4.1-mini
# Ollama 本地 LLM 地址 (backup 引擎)
FOOTBALL_BACKUP_LLM_BASE_URL=http://localhost:11434/v1
FOOTBALL_BACKUP_LLM_MODEL=qwen2.5:7b
# LLM 重试次数
FOOTBALL_LLM_RETRIES=2
# LLM 超时秒数
FOOTBALL_LLM_TIMEOUT_SECONDS=45

# ---- 搜索引擎 ----
# SearXNG 自建搜索 URL (可选，默认优先)
# FOOTBALL_SEARXNG_BASE_URL=<YOUR_SEARXNG_URL>
# Serper.dev Google Search API (可选，SearXNG 不可用或质量不足时备用)
# FOOTBALL_SERPER_API_KEY=<YOUR_SERPER_API_KEY>
# 兼容旧变量名：如暂未迁移，FOOTBALL_GOOGLE_SEARCH_API_KEY 会被当作 Serper key 使用。
# FOOTBALL_GOOGLE_SEARCH_API_KEY=<YOUR_SERPER_API_KEY>
FOOTBALL_SEARCH_TIMEOUT_SECONDS=15

# 抓取预览管理入口（默认不注册）
FOOTBALL_ENABLE_FETCH_PREVIEW=false
# 启用后必须在本地设置管理令牌，真实值不得提交到仓库
# FOOTBALL_FETCH_PREVIEW_ADMIN_TOKEN=<YOUR_ADMIN_TOKEN>

# ---- 外部数据同步 ----
# 中国竞彩网官方公开接口/页面（竞彩足球固定奖金主数据源）
# 仅用于数据读取和辅助决策，不提供投注、代购或互联网售彩能力。
# FOOTBALL_SPORTTERY_BASE_URL=https://www.sporttery.cn

# football-data.org API Token (免费层)
# 只填纯 token，不要包含 "X-Auth-Token:"。
# FOOTBALL_DATA_API_TOKEN=<YOUR_API_TOKEN>
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# API-Football Token (免费层)
# 只填纯 token，不要包含 "x-apisports-key:"。
# API_FOOTBALL_TOKEN=<YOUR_API_TOKEN>
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# TheSportsDB API Token (免费)
# THESPORTSDB_API_TOKEN=<YOUR_API_TOKEN>
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
# Sportmonks API Token (14天试用，世界杯专用)
# SPORTMONKS_API_TOKEN=<YOUR_API_TOKEN>
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
# iSports API Token (15天试用，世界杯专用)
# ISPORTS_API_TOKEN=<YOUR_API_TOKEN>
ISPORTS_BASE_URL=https://api.isportsapi.com

# 结构化同步来源标识
FOOTBALL_STRUCTURED_SYNC_SOURCE=structured_provider_placeholder
# 新闻同步来源标识
FOOTBALL_NEWS_SYNC_SOURCE=news_provider_placeholder

# ---- 特征工程 ----
# DuckDB 特征查询视图或 SQL (默认三层宽表)
FOOTBALL_FEATURE_VIEW_OR_QUERY=core.view_llm_match_prediction_base

# ---- 数据同步 ----
# 日期滑窗：当指定日期找不到目标比赛时，自动向后滑动重试的最大天数（默认 7）
FOOTBALL_DATE_SLIDE_MAX_DAYS=7
# 赛后采集开关：每次预测前自动拉取遗漏的 TOP5+世界杯完赛数据（默认 1）
FOOTBALL_POST_MATCH_COLLECT_ENABLED=1
# 赛后采集目标联赛（逗号分隔，默认五大联赛+世界杯）
# FOOTBALL_POST_MATCH_COLLECT_LEAGUES=TOP5_EPL,TOP5_LA_LIGA,TOP5_SERIE_A,TOP5_BUNDESLIGA,TOP5_LIGUE_1,WC_WORLD_CUP_2026

# ---- 赛前预采集 ----
# 赛前预采集开关：每次预测前自动拉取未来 N 天的赛程 + 赔率快照 + 阵容（默认 1）
FOOTBALL_PRE_MATCH_COLLECT_ENABLED=1
# 赛前预采集向前看天数（默认 3 天，API-Football 免费层仅支持 ±3 天）
FOOTBALL_PRE_MATCH_LOOKAHEAD_DAYS=3
# 赛前预采集目标联赛（逗号分隔，默认五大联赛+世界杯）
# FOOTBALL_PRE_MATCH_COLLECT_LEAGUES=TOP5_EPL,TOP5_LA_LIGA,TOP5_SERIE_A,TOP5_BUNDESLIGA,TOP5_LIGUE_1,WC_WORLD_CUP_2026
